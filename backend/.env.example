# Copia este archivo como .env y cambia los valores. Nunca subas .env a Git.
PORT=3000

# --- Base de datos (local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nova_db
DB_USER=postgres
DB_PASSWORD=change_me
# --- Base de datos (nube): si se define, reemplaza las variables DB_* ---
# DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
# DB_SSL=true

# Minimo 32 caracteres aleatorios. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Origenes del frontend cuando se abre con Live Server (separados por comas).
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Almacenamiento de archivos (persistencia dual) ---
# Con SUPABASE_URL y SUPABASE_SECRET_KEY los archivos van a Supabase Storage (bucket privado).
# Sin ellas se guardan en backend/uploads (solo para desarrollo).
SUPABASE_URL=
# Clave secreta sb_secret_... (Settings > API Keys). Solo backend, jamas en el frontend.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=nova-archivos
# STORAGE_DRIVER=supabase   # opcional: obliga a usar Supabase y falla si faltan las claves
MAX_FILE_SIZE_MB=5

# --- Produccion ---
# NODE_ENV=production        # cookies Secure y trust proxy
# COOKIE_SAMESITE=none       # solo si frontend y API quedan en dominios distintos
# SERVE_FRONTEND=false       # si el frontend se publica aparte
